/dts-v1/;

#include "sun60i-a733.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Radxa Cubie A7S";
	compatible = "radxa,cubie-a7s", "allwinner,sun60i-a733";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reg_vcc3v3: vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&mmc0 {
	vmmc-supply = <&reg_vcc3v3>;
	bus-width = <4>;
	no-mmc;
	no-sdio;
	status = "okay";
};

&gmac0 {
	phy-handle = <&ext_rgmii_phy>;
	/*
	 * Vendor uses MAC-side raw delay fields. Defer upstream ps delay
	 * properties until link tests prove the correct conversion.
	 */
	phy-mode = "rgmii";
	status = "okay";
};

&mdio0 {
	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		max-speed = <1000>;
		reset-gpios = <&pio 7 16 GPIO_ACTIVE_LOW>; /* PH16 */
		reset-assert-us = <10000>;
		reset-deassert-us = <150000>;
	};
};

&pio {
	uart0_pb9_pb10_pins: uart0-pb9-pb10-pins {
		pins = "PB9", "PB10";
		allwinner,pinmux = <2>;
		function = "uart0";
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb9_pb10_pins>;
	status = "okay";
};
